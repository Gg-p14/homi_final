@model ReservaPagoViewModel
@{
    ViewData["Title"] = "Pago de la reserva";
    var r = Model.Reserva;
}
<section class="tarjeta formulario">
    <h1>Pagar reserva</h1>
    <p>@r.Titulo · @r.FechaEntrada.ToString("dd/MM/yyyy") al @r.FechaSalida.ToString("dd/MM/yyyy") · @r.NumeroHuespedes huésped(es)</p>

    <p>Tu lugar está apartado. Tienes 30 minutos para completar el pago.</p>
    <p>Tiempo restante: <strong class="cuenta-regresiva" data-cuenta-regresiva data-segundos="@Model.SegundosRestantes">--:--</strong></p>

    <table class="desglose">
        @foreach (var c in Model.Cargos)
        {
            <tr><td>@c.Concepto</td><td>$@c.Monto.ToString("N2")</td></tr>
        }
        <tr class="total"><td>Total</td><td>$@Model.Cargos.Sum(c => c.Monto).ToString("N2")</td></tr>
    </table>

    <div class="acciones-pago">
        <form asp-action="ConfirmarPago" asp-route-id="@r.Id" method="post">
            <button type="submit" class="boton">Confirmar pago</button>
        </form>
        <form asp-action="Cancelar" asp-route-id="@r.Id" method="post" data-confirmar="¿Seguro que quieres cancelar esta reserva? Las noches se liberarán.">
            <button type="submit" class="boton secundario">Cancelar reserva</button>
        </form>
    </div>
</section>
