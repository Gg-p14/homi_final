@model UsuariosAdminViewModel
@{
    ViewData["Title"] = "Usuarios";
}
<h1>Usuarios</h1>

<form method="get" asp-action="Usuarios" class="filtros">
    <input type="text" name="buscar" value="@Model.Buscar" placeholder="Nombre o correo" />
    <select name="activo">
        <option value="">Todos</option>
        <option value="true" selected="@(Model.Activo == true ? "selected" : null)">Activos</option>
        <option value="false" selected="@(Model.Activo == false ? "selected" : null)">Desactivados</option>
    </select>
    <button type="submit" class="boton">Buscar</button>
</form>

<table class="tabla">
    <thead><tr><th>Nombre</th><th>Correo</th><th>Teléfono</th><th>Estado</th><th>Rol</th><th></th></tr></thead>
    <tbody>
    @foreach (var u in Model.Usuarios)
    {
        var esYo = u.Id == Model.ActualId;
        <tr>
            <td>@u.Nombre @u.Apellido @(esYo ? "(tú)" : "")</td>
            <td>@u.Email</td>
            <td>@u.Telefono</td>
            <td>@(u.Activo ? "Activo" : "Desactivado")</td>
            <td>@(u.EsSuperAdmin ? "Superadministrador" : "Usuario")</td>
            <td class="acciones"><a asp-action="EditarUsuario" asp-route-id="@u.Id">Editar</a> 
                @if (!esYo)
                {
                    @if (u.Activo)
                    {
                        <form asp-action="Desactivar" asp-route-id="@u.Id" method="post" data-confirmar="¿Desactivar esta cuenta? Sus reservas futuras se cancelarán.">
                            <button type="submit" class="enlace-boton">Desactivar</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Activar" asp-route-id="@u.Id" method="post">
                            <button type="submit" class="enlace-boton">Activar</button>
                        </form>
                    }
                    <form asp-action="AsignarSuperAdmin" asp-route-id="@u.Id" method="post">
                        <input type="hidden" name="asignar" value="@(u.EsSuperAdmin ? "false" : "true")" />
                        <button type="submit" class="enlace-boton">@(u.EsSuperAdmin ? "Quitar superadmin" : "Hacer superadmin")</button>
                    </form>
                    <form asp-action="Eliminar" asp-route-id="@u.Id" method="post" data-confirmar="¿Eliminar esta cuenta de forma permanente? Solo se permite si no tiene reservas ni alojamientos.">
                        <button type="submit" class="enlace-boton">Eliminar</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
