@model ReportesViewModel
@{
    ViewData["Title"] = "Reportes";
}
<h1>Reportes</h1>

<form method="get" asp-action="Reportes" class="filtros">
    <label>Desde</label>
    <input type="date" name="desde" value="@Model.Desde.ToString("yyyy-MM-dd")" />
    <label>Hasta</label>
    <input type="date" name="hasta" value="@Model.Hasta.ToString("yyyy-MM-dd")" />
    <button type="submit" class="boton">Generar</button>
</form>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alerta error">@Model.Error</div>
}
else
{
    <div class="resumen">
        <div class="tarjeta"><span>Reservas en el periodo</span><strong>@Model.TotalReservas</strong></div>
        <div class="tarjeta"><span>Comisiones de Homi</span><strong>$@Model.TotalIngresos.ToString("N2")</strong></div>
    </div>

    <h2>Reservas por fecha de entrada</h2>
    <table class="tabla">
        <thead><tr><th>Fecha de entrada</th><th>Reservas</th></tr></thead>
        <tbody>
        @foreach (var d in Model.ReservasPorDia)
        {
            <tr><td>@d.Dia.ToString("dd/MM/yyyy")</td><td>@d.Reservas</td></tr>
        }
        </tbody>
    </table>
    @if (!Model.ReservasPorDia.Any())
    {
        <p>No hay reservas en este periodo.</p>
    }

    <h2>Comisiones por ciudad</h2>
    <table class="tabla">
        <thead><tr><th>Ciudad</th><th>Comisión</th></tr></thead>
        <tbody>
        @foreach (var c in Model.IngresosPorCiudad)
        {
            <tr><td>@c.Ciudad</td><td>$@c.Ingresos.ToString("N2")</td></tr>
        }
        </tbody>
    </table>
    @if (!Model.IngresosPorCiudad.Any())
    {
        <p>No hay ingresos en este periodo.</p>
    }
}
